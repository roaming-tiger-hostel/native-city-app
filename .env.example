# 실제 키는 .env.local 또는 Vercel 환경변수에만 저장하세요.
# 로컬: 실행 중인 Ollama의 OpenAI-compatible endpoint (TUC와 같은 모델).
# 키가 없어도 loopback endpoint는 dummy 'ollama'를 사용합니다.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.8:27b-mlx
LLM_API_KEY=ollama
# 가벼운 대안: LLM_MODEL=qwen3.5:4b

# 배포: Vercel의 localhost는 맥미니가 아닙니다. 아래처럼 별도 설정하세요.
# QWEN_API_KEY=<DashScope 실제 키>
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY는 비워 두세요. 별칭: QWEN_API_KEY / DASHSCOPE_API_KEY
# 실수로 로컬 URL이 배포되면 QWEN_API_KEY로 DashScope 전환, 없으면 엔진.
# 키 없음 / 서버 오류 / 시간초과 / 검증 실패 시 기존 규칙 엔진으로 폴백.

# 선택: TourAPI. 없거나 호출 실패 시 데모 장소를 사용합니다.
TOUR_API_KEY=
