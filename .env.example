# Qwen / DashScope. 실제 키는 이 예제 파일이 아니라 .env.local 에 넣으세요.
# 키가 없거나 호출이 실패하면 규칙 엔진 + 옵션 채팅이 동작합니다.
QWEN_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 대체 키 이름: 비어 있지 않은 값 중 LLM_API_KEY → QWEN_API_KEY → DASHSCOPE_API_KEY 순서.
# LLM_API_KEY=
# DASHSCOPE_API_KEY=

# 선택: TourAPI. 없으면 데모 시드 장소를 사용합니다.
TOUR_API_KEY=
